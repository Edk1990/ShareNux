<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.EndsWith('-windows'))">
    <!-- Existing Windows printing and shell icon interop still require System.Drawing.Common. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.EndsWith('-windows'))">
    <Compile Remove="Printer\PrintHelper.cs" />
    <Compile Remove="Printer\PrintTextHelper.cs" />
    <Compile Remove="Printer\WindowsPrintDialog.cs" />
    <Compile Remove="Native\WindowsPrintInterop.cs" />
    <Compile Remove="Presentation\Print\**" />
    <AvaloniaResource Remove="Presentation\Print\**" />
    <AvaloniaXaml Remove="Presentation\Print\**" />
    <None Remove="Presentation\Print\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShareX.Avalonia\ShareX.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Localization\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
